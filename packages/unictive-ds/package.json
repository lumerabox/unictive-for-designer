{
  "name": "unictive-ds",
  "version": "1.1.0",
  "description": "Unictive Design System: tokens and component classes in plain CSS, with an optional Tailwind CSS v4 theme",
  "homepage": "https://design.unictive.net",
  "license": "MIT",
  "keywords": [
    "design-system",
    "css",
    "tailwindcss",
    "design-tokens",
    "unictive"
  ],
  "style": "unictive.css",
  "jsdelivr": "unictive.css",
  "unpkg": "unictive.css",
  "exports": {
    ".": {
      "style": "./unictive.css",
      "default": "./unictive.css"
    },
    "./unictive.css": "./unictive.css",
    "./tailwind.css": "./tailwind.css",
    "./unictive-tailwind.css": "./unictive-tailwind.css",
    "./tokens.css": "./tokens.css",
    "./tokens.json": "./tokens.json",
    "./motion.css": "./motion.css",
    "./motion.js": "./motion.js",
    "./package.json": "./package.json"
  },
  "files": [
    "unictive.css",
    "tailwind.css",
    "unictive-tailwind.css",
    "tokens.css",
    "tokens.json",
    "motion.css",
    "motion.js"
  ],
  "sideEffects": [
    "*.css",
    "motion.js"
  ],
  "peerDependencies": {
    "tailwindcss": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  }
}
