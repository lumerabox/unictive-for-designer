---
// template for every doc page: sidebar, header, sections, pager
import Base from './Base.astro';
import Link from '../components/doc/Link.astro';
import { sideNav, livePages, topNav, sectionOf } from '../data/nav';

interface Props {
  title: string;
  description: string;
  intro: string;
  section?: string;
  meta?: [label: string, value: string | number][];
  // name of the scripts/<name>-page.ts module that runs this page
  script?: string;
}
const { title, description, intro, section = 'Components', meta = [], script } = Astro.props;

const group = sideNav.find((g) => g.items.includes(title))?.group ?? '';
// matches the first url segment, which the sidebar script compares against
const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9 ]/g, '').replace(/ /g, '-');
const flat = sideNav.filter((g) => sectionOf(g.group) === section).flatMap((g) => g.items);
const at = flat.indexOf(title);
const prev = at > 0 ? flat[at - 1] : null;
const next = at >= 0 && at < flat.length - 1 ? flat[at + 1] : null;
---
<Base title={title} description={description} active={section}>
  <div class="shell">
    <div class="scrim" data-scrim aria-hidden="true"></div>
    <aside id="sidebar" class="sidebar" aria-label={section} transition:name="sidebar" transition:persist="sidebar" transition:animate="none">
      <nav class="drawer-nav" aria-label="Sections">
        {topNav.map((n) => n.href
          ? <a href={n.href} aria-current={n.label === section ? 'page' : undefined}>{n.label}</a>
          : <button type="button" data-soon={n.label}>{n.label}</button>)}
      </nav>
      <nav>
        {sideNav.map((g) => (
          <div class="side-group" data-section={slug(sectionOf(g.group))} hidden={sectionOf(g.group) !== section}>
            <p class="label">{g.group}</p>
            <ul>
              {g.items.map((item) => livePages[item]
                ? <li><a class="side-item" href={livePages[item]} aria-current={item === title ? 'page' : undefined}>{item}</a></li>
                : <li><button type="button" class="side-item" data-soon={item}>{item}</button></li>)}
            </ul>
          </div>
        ))}
      </nav>
    </aside>

    <div class="center" id="content" data-script={script}>
      <header class="page-head">
        <p class="crumbs"><span class="label">{section}</span>{group && group !== section && <><span class="slash">/</span><span class="label">{group}</span></>}</p>
        <h1>{title}</h1>
        <div class="intro">
          <p>{intro}</p>
          <slot name="action" />
        </div>
        {meta.length > 0 && (
          <dl class="meta">
            {meta.map(([k, v]) => <div><dt class="label muted">{k}</dt><dd>{v}</dd></div>)}
          </dl>
        )}
      </header>

      <main class="main">
          <slot />
          <nav class="pager" aria-label="Pagination">
            {prev
              ? <Link class="pager-item" href={livePages[prev]} name={prev}>
                  <svg class="pager-arrow" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M12.5 8h-9m0 0L7.5 4m-4 4 4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  <span class="pager-text"><span class="pager-label">Previous</span><span class="pager-title">{prev}</span></span>
                </Link>
              : <span></span>}
            {next && <Link class="pager-item next" href={livePages[next]} name={next}>
              <span class="pager-text"><span class="pager-label">Next</span><span class="pager-title">{next}</span></span>
              <svg class="pager-arrow" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3.5 8h9m0 0L8.5 4m4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </Link>}
          </nav>
      </main>
    </div>
  </div>
</Base>

<script>
  import '../scripts/doc-page';
</script>
