---
import '../styles/global.css';
import '../styles/u-button.css';
import '../styles/doc.css';
import { topNav, sideNav, livePages } from '../data/nav';

interface Props {
  title: string;
  description: string;
  active?: string;
}
const { title, description, active = 'Components' } = Astro.props;
const searchItems = sideNav.flatMap((g) => g.items.map((i) => ({ label: i, group: g.group, href: livePages[i] ?? null })));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <title>{title} · Unictive for Designer</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="guides" aria-hidden="true"></div>
    <a class="skip" href="#content">Skip to content</a>

    <header class="topbar">
      <div class="topbar-inner">
        <a class="brand" href="/" aria-label="Unictive for Designer, home">
          <svg width="33" height="16" viewBox="0 0 33 16" aria-hidden="true"><path fill="#1868D0" d="M13.8844 8.14276L10.5819 11.4075C9.83519 12.0251 8.88751 12.5545 7.85367 12.5545C5.47009 12.5545 3.546 10.584 3.546 8.14276C3.546 5.70158 5.47009 3.73098 7.85367 3.73098C9.03109 3.73098 10.1224 4.23098 10.8978 5.0251L12.5921 6.67217L13.8844 8.14276ZM15.3777 4.23098C15.3777 4.23098 11.8454 -0.298447 7.65264 0.0250836C3.48857 0.378026 1.56448 3.17216 1.56448 3.17216C1.56448 3.17216 -0.589356 5.93687 0.157306 9.64277C0.903968 13.3781 3.71831 14.8487 3.71831 14.8487C3.71831 14.8487 6.73367 16.6134 9.63417 15.731C12.5347 14.8487 13.4249 13.584 13.4249 13.584L16.2967 10.6134L19.9726 14.231C19.9726 14.231 22.4136 16.6134 26.233 15.8487C26.233 15.8487 29.794 15.4663 31.8617 11.731C33.9294 7.9957 31.8617 4.40745 31.8617 4.40745C31.8617 4.40745 29.7653 -0.386683 23.9069 0.0250836C21.7818 0.172143 19.8003 1.67215 18.1633 3.55451L16.4116 5.43687L15.3777 4.23098ZM24.9695 12.5251C23.9356 12.5251 22.9592 12.0251 22.2413 11.3781L18.8526 8.05453L21.9254 5.05452C22.7008 4.26039 23.7633 3.76039 24.9695 3.76039C27.353 3.76039 29.2771 5.73099 29.2771 8.17217C29.2771 10.6134 27.353 12.5251 24.9695 12.5251Z"/></svg>
          <span>For Designer</span>
        </a>
        <nav class="topnav" aria-label="Primary">
          {topNav.map((n) => n.href
            ? <a href={n.href} aria-current={n.label === active ? 'page' : undefined}>{n.label}</a>
            : <button type="button" class="soon" data-soon={n.label}>{n.label}</button>)}
        </nav>
        <button class="search" type="button" data-search-open aria-label="Search components">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M14 14L11.1 11.1M12.6667 7.33333C12.6667 10.2789 10.2789 12.6667 7.33333 12.6667C4.38781 12.6667 2 10.2789 2 7.33333C2 4.38781 4.38781 2 7.33333 2C10.2789 2 12.6667 4.38781 12.6667 7.33333Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span class="search-text">Search</span>
          <kbd>⌘K</kbd>
        </button>
        <button class="menu" type="button" data-menu-open aria-label="Open menu" aria-expanded="false" aria-controls="sidebar">
          <span></span><span></span>
        </button>
      </div>
    </header>

    <slot />

    <dialog class="palette" data-palette aria-label="Search">
      <div class="palette-box">
        <div class="palette-input">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M14 14L11.1 11.1M12.6667 7.33333C12.6667 10.2789 10.2789 12.6667 7.33333 12.6667C4.38781 12.6667 2 10.2789 2 7.33333C2 4.38781 4.38781 2 7.33333 2C10.2789 2 12.6667 4.38781 12.6667 7.33333Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <input type="search" placeholder="Search components" aria-label="Search components" autocomplete="off" data-palette-input />
          <kbd>Esc</kbd>
        </div>
        <ul class="palette-list" role="listbox" data-palette-list>
          {searchItems.map((i) => (
            <li role="option" data-item={i.label.toLowerCase()} data-href={i.href ?? ''} aria-selected="false">
              <span>{i.label}</span>
              <span class="label muted">{i.href ? i.group : 'Soon'}</span>
            </li>
          ))}
        </ul>
        <p class="palette-empty" data-palette-empty hidden>No components match</p>
      </div>
    </dialog>

    <div class="toast" role="status" aria-live="polite" data-toast></div>

    <script>
      import '../scripts/chrome';
    </script>
  </body>
</html>

<style>
  .skip { position: absolute; left: -9999px; top: 8px; z-index: 100; background: var(--bg-strong-950); color: #fff; padding: 8px 12px; font-size: 14px; }
  .skip:focus { left: 8px; }

  .topbar { position: sticky; top: 0; z-index: 40; height: var(--topbar); background: rgb(255 255 255 / 0.92); backdrop-filter: blur(12px); border-bottom: var(--line); }
  .topbar-inner { height: 100%; max-width: calc(var(--container) + 2 * var(--margin)); margin: 0 auto; padding: 0 var(--margin); display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 24px; }
  .brand { display: inline-flex; align-items: center; gap: 16px; justify-self: start; }
  .brand span { white-space: nowrap; font-size: 10px; line-height: 12px; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; }
  .topnav { display: flex; gap: 32px; white-space: nowrap; }
  .topnav a, .topnav button { font-size: 14px; line-height: 20px; font-weight: 500; color: var(--text-strong-950); background: none; border: 0; padding: 0; cursor: pointer; transition: color 120ms var(--ease); }
  .topnav a[aria-current='page'] { color: var(--brand); }
  .topnav a:hover, .topnav button:hover { color: var(--brand); }
  .search { justify-self: end; width: 240px; height: 40px; display: flex; align-items: center; gap: 8px; padding: 0 12px; border: 0; background: var(--bg-weak-50); color: var(--text-sub-600); font-size: 14px; cursor: pointer; transition: background-color 120ms var(--ease); }
  .search:hover { background: var(--bg-soft-200); }
  .search-text { flex: 1; text-align: left; }
  kbd { font: 500 12px/16px 'Inter', sans-serif; color: var(--text-soft-400); }
  .menu { display: none; }

  @media (max-width: 1279px) {
    .topnav { gap: 24px; }
    .search { width: 160px; }
  }

  @media (max-width: 1023px) {
    .topbar-inner { grid-template-columns: 1fr auto auto; gap: 8px; }
    .topnav { display: none; }
    .search { width: 40px; padding: 0; justify-content: center; }
    .search-text, .search kbd { display: none; }
    .menu { display: inline-flex; flex-direction: column; justify-content: center; gap: 6px; width: 40px; height: 40px; padding: 0 11px; border: 0; background: var(--bg-strong-950); cursor: pointer; }
    .menu span { height: 1.5px; background: #fff; transition: transform 200ms var(--ease); }
    :global(body.nav-open) .menu span:first-child { transform: translateY(3.75px) rotate(45deg); }
    :global(body.nav-open) .menu span:last-child { transform: translateY(-3.75px) rotate(-45deg); }
  }

  .palette { padding: 0; border: 0; background: transparent; width: min(560px, calc(100% - 32px)); max-height: none; margin: 12vh auto auto; overflow: visible; }
  .palette::backdrop { background: rgb(23 23 23 / 0.32); }
  .palette[open] .palette-box { animation: pop 160ms var(--ease); }
  @keyframes pop { from { opacity: 0; transform: translateY(-6px) scale(0.98); } }
  .palette-box { background: #fff; box-shadow: 0 16px 48px rgb(0 0 0 / 0.16); }
  .palette-input { display: flex; align-items: center; gap: 12px; height: 56px; padding: 0 16px; border-bottom: var(--line); color: var(--text-sub-600); }
  .palette-input input { flex: 1; border: 0; outline: 0; font-size: 16px; color: var(--text-strong-950); background: transparent; }
  .palette-list { list-style: none; margin: 0; padding: 8px; max-height: 360px; overflow: auto; }
  .palette-list li { display: flex; justify-content: space-between; align-items: center; height: 40px; padding: 0 12px; font-size: 14px; cursor: pointer; }
  .palette-list li[aria-selected='true'] { background: var(--bg-weak-50); }
  .palette-list li[data-href=''] > span:first-child { color: var(--text-soft-400); }
  .palette-list li[hidden] { display: none; }
  .palette-empty { padding: 24px 20px; font-size: 14px; color: var(--text-sub-600); }

  .toast { position: fixed; left: 50%; bottom: 24px; z-index: 60; transform: translate(-50%, 16px); opacity: 0; pointer-events: none; display: flex; align-items: center; gap: 10px; max-width: calc(100% - 32px); padding: 10px 14px; background: var(--bg-strong-950); color: #fff; font-size: 13px; line-height: 18px; transition: opacity 180ms var(--ease), transform 180ms var(--ease); }
  .toast.show { opacity: 1; transform: translate(-50%, 0); }
  .toast :global(kbd) { color: rgb(255 255 255 / 0.56); }
</style>
