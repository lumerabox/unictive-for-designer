---
interface Props {
  use: string[];
  avoid: string[];
}
const { use, avoid } = Astro.props;
---
<div class="grid2">
  <div class="usage">
    <p class="usage-head"><span class="label">Use when</span></p>
    <ol>{use.map((t) => <li>{t}</li>)}</ol>
  </div>
  <div class="usage">
    <p class="usage-head"><span class="label dark">Avoid when</span></p>
    <ol>{avoid.map((t) => <li>{t}</li>)}</ol>
  </div>
</div>
