---
// one playground select, same markup as the field pages
interface Props {
  name: string;
  label: string;
  options: readonly (string | [value: string, text: string])[];
  value?: string;
}
const { name, label, options, value } = Astro.props;
const opts = options.map((o) => (typeof o === 'string' ? [o, o] : o));
---
<label class="field">
  <span class="label muted">{label}</span>
  <span class="select">
    <select name={name}>
      {opts.map(([v, t]) => <option value={v} selected={v === value}>{t}</option>)}
    </select>
    <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M5 7.5L10 12.5L15 7.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </span>
</label>
