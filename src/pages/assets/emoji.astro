---
import DocPage from '../../layouts/DocPage.astro';
import Section from '../../components/doc/Section.astro';
import Usage from '../../components/doc/Usage.astro';
import Related from '../../components/doc/Related.astro';
import TailwindSection from '../../components/doc/TailwindSection.astro';
import AssetLibrary from '../../components/AssetLibrary.astro';
import data from '../../data/assets.json';

const groups = data.filter((g) => g.kind === 'emoji');
const count = groups.reduce((n, g) => n + g.items.filter(([name]) => !name.endsWith(', alt')).length, 0);
const twSizes: [string, string, string][] = [['label-md', 'text-label-md', '16 px'], ['title-h6', 'text-title-h6', '20 px'], ['title-h5', 'text-title-h5', '24 px'], ['title-h4', 'text-title-h4', '32 px'], ['title-h3', 'text-title-h3', '40 px']];
const twExample = `<p class="flex items-center gap-8 text-label-md text-text-strong-950">
  <span class="text-title-h5" role="img" aria-label="Party popper">🎉</span>
  Payment received
</p>`;
---
<DocPage
  title="Emoji"
  section="Assets"
  script="assets"
  description="Search and copy emoji from the Unictive design system. Click one to copy it as text, then paste it into Figma or code and swap it like any character."
  intro="Emoji for reactions, ratings and friendly moments. Click one to copy it as text, then paste it into Figma or code"
  meta={[['Emoji', count], ['Categories', groups.length], ['Format', 'Unicode text']]}
>
  <Section id="library" label="Library" desc="Pastes as a text layer you can resize and swap by typing another emoji. Need the 3D look? The arrow downloads the 3D PNG at 3x">
    <AssetLibrary kind="emoji" size={40} paste={24} placeholder="smile, heart, food…" />
  </Section>

  <TailwindSection
    desc="Emoji are text, so a text- class sets their size like any other character. Add role=img and an aria-label so screen readers read a name. Click a class to copy it"
    tables={[{ title: 'Size', note: 'Only the font size matters, the color classes do not change an emoji', rows: twSizes }]}
    example={twExample}
  />

  <Section id="usage" label="Usage" title="When to use">
    <Usage
      use={['Feedback and ratings ask how something felt', 'Empty states, success screens and onboarding need warmth', 'Reactions in chat or comments']}
      avoid={['The emoji is the only way to read a status or an error', 'Formal moments like payments, contracts or errors', 'More than one or two per screen']}
    />
  </Section>

  <Section id="related" label="Related" title="Related">
    <Related items={[
      ['Rating', 'Scores and reviews'],
      ['Avatars', 'Illustrated characters'],
      ['Icons', 'Interface icons'],
      ['Modal', 'Success and empty states'],
    ]} />
  </Section>
</DocPage>
