---
import DocPage from '../../layouts/DocPage.astro';
import Section from '../../components/doc/Section.astro';
import Usage from '../../components/doc/Usage.astro';
import Related from '../../components/doc/Related.astro';
import TailwindSection from '../../components/doc/TailwindSection.astro';
import AssetLibrary from '../../components/AssetLibrary.astro';
import data from '../../data/assets.json';

const count = data.filter((g) => g.kind === 'avatars').reduce((n, g) => n + g.items.length, 0);
const twSizes: [string, string, string][] = [['spacing-24', 'size-24', '24 px'], ['spacing-32', 'size-32', '32 px'], ['spacing-40', 'size-40', '40 px'], ['spacing-48', 'size-48', '48 px'], ['spacing-64', 'size-64', '64 px']];
const twShape: [string, string, string][] = [['radius-full', 'rounded-full', '999 px']];
const twExample = `<div class="flex items-center gap-12">
  <img class="size-40 rounded-full object-cover" src="character-01.png" alt="Character 01" />
  <span class="text-label-sm text-text-strong-950">Character 01</span>
</div>`;
---
<DocPage
  title="Avatars"
  section="Assets"
  script="assets"
  description="Preview and copy the Unictive avatar characters. Click one to copy it, then paste it into Figma at 64 px."
  intro="Ten illustrated characters, plain or on a colored background. Click one to copy it, then paste it into Figma"
  meta={[['Characters', count / 2], ['Styles', 2], ['Paste size', '64 px']]}
>
  <Section id="library" label="Library" desc="Pastes into Figma as a 64 × 64 image. Use the arrow to download the PNG at 2x">
    <AssetLibrary kind="avatars" size={64} paste={64} placeholder="01, background…" />
  </Section>

  <TailwindSection
    desc="Download the PNG with the arrow, then size it with size- and round it with rounded-full. Click a class to copy it"
    tables={[
      { title: 'Size', rows: twSizes },
      { title: 'Shape', note: 'The characters are already round. Keep rounded-full on so a real photo swapped in later stays round too', rows: twShape },
    ]}
    example={twExample}
  />

  <Section id="usage" label="Usage" title="When to use">
    <Usage
      use={['A person has no profile photo yet', 'Mockups and prototypes need realistic people', 'Empty states and onboarding show who something is for']}
      avoid={['A real photo is available, show the photo', 'The same character stands for two people in one view', 'Status or role needs to be read, add a badge or text']}
    />
  </Section>

  <Section id="related" label="Related" title="Related">
    <Related items={[
      ['Brand Logos', 'Company and app logos'],
      ['Emoji', 'Expressive images'],
      ['Badge', 'Status next to an avatar'],
      ['Dropdown', 'Avatars in list items'],
    ]} />
  </Section>
</DocPage>
