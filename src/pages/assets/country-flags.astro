---
import DocPage from '../../layouts/DocPage.astro';
import Section from '../../components/doc/Section.astro';
import Usage from '../../components/doc/Usage.astro';
import Related from '../../components/doc/Related.astro';
import TailwindSection from '../../components/doc/TailwindSection.astro';
import AssetLibrary from '../../components/AssetLibrary.astro';
import data from '../../data/assets.json';

const count = data.filter((g) => g.kind === 'flags').reduce((n, g) => n + g.items.length, 0);
const twSizes: [string, string, string][] = [['spacing-16', 'size-16', '16 px'], ['spacing-20', 'size-20', '20 px'], ['spacing-24', 'size-24', '24 px'], ['spacing-32', 'size-32', '32 px']];
const twExample = `<label class="flex items-center gap-8 rounded-10 border border-stroke-soft-200 px-12 py-10">
  <img class="size-20 rounded-full" src="indonesia.svg" alt="Indonesia" />
  <span class="text-paragraph-sm text-text-sub-600">+62</span>
  <input class="flex-1 text-paragraph-sm text-text-strong-950 outline-none" type="tel" placeholder="812 3456 7890" />
</label>`;
---
<DocPage
  title="Country Flags"
  section="Assets"
  script="assets"
  description="Search and copy round country and region flags from the Unictive design system. Click a flag to copy its SVG and paste it into Figma."
  intro="Round flags for countries, regions and organizations. Click one to copy its SVG, then paste it into Figma or code"
  meta={[['Flags', count], ['Shape', 'Circle'], ['Format', 'SVG']]}
>
  <Section id="library" label="Library" desc="Flags paste as vectors at 24 px, the size used in phone and currency fields">
    <AssetLibrary kind="flags" size={40} paste={24} placeholder="indonesia, japan…" />
  </Section>

  <TailwindSection
    desc="Download the SVG with the arrow and set its size with size-. The flags are already round. Click a class to copy it"
    tables={[{ title: 'Size', note: 'Use 20 in phone and currency fields, 24 in lists', rows: twSizes }]}
    example={twExample}
  />

  <Section id="usage" label="Usage" title="When to use">
    <Usage
      use={['People choose a country code, currency or language', 'A list of countries needs to be scanned quickly', 'An amount or account belongs to a specific country']}
      avoid={['Standing in for a language on its own, write the language name', 'The flag is the only label, add the country name', 'Showing many flags at sizes under 16 px']}
    />
  </Section>

  <Section id="related" label="Related" title="Related">
    <Related items={[
      ['Dropdown', 'Country and currency pickers'],
      ['Text Input', 'Phone numbers'],
      ['Brand Logos', 'Banks and wallets'],
      ['Emoji', 'Expressive images'],
    ]} />
  </Section>
</DocPage>
