---
import DocPage from '../../layouts/DocPage.astro';
import Section from '../../components/doc/Section.astro';
import SpecsTable from '../../components/doc/SpecsTable.astro';
import Usage from '../../components/doc/Usage.astro';
import DoDont from '../../components/doc/DoDont.astro';
import Related from '../../components/doc/Related.astro';
import PgSelect from '../../components/choice/PgSelect.astro';
import '../../styles/u-actions.css';
import { socialStyles, socialStates, brands, socialButton, socialChip } from '../../data/actions';

const specs: [string, string, string][] = [
  ['Height', '—', '44 px, 44 × 44 when icon only'],
  ['Padding', 'spacing-12 · 16', '12 / 16 / 12 / 12 px, 12 px when icon only'],
  ['Logo', '—', '20 px, a Major Brand Logos instance'],
  ['Logo to text gap', 'spacing-8', '8 px'],
  ['Text', 'Label / Small', 'Inter Medium 14/20'],
  ['Corner radius', 'radius-8', '8 px, 999 px when rounded'],
  ['Neutral', 'bg/surface-800 · text/white-0', '#262626, white logo'],
  ['Neutral hover', 'bg/strong-950', '#171717'],
  ['Stroke', 'stroke/soft-200 · text/strong-950', '1 px inside, original logo'],
  ['White', 'bg/white-0 · text/strong-950', '#FFFFFF, original logo'],
  ['Stroke and White hover', 'bg/weak-50', '#F7F7F7'],
];
---
<DocPage
  script="actions"
  title="Social Button"
  description="Social Buttons let people sign in with a provider like Google or Apple. Explore every style, state and shape of the Unictive social button."
  intro="Social Buttons let people sign in or sign up with an account they already have, like Google, Apple or GitHub"
  meta={[['Variants', 24], ['Styles', socialStyles.length], ['Providers', brands.length]]}
>
  <Section id="playground" label="Playground" desc="Pick a style and a provider, then hover and click the preview">
    <form class="pg" data-playground data-kind="social" onsubmit="return false">
      <div class="fields">
        <PgSelect name="style" label="Style" options={socialStyles} />
        <PgSelect name="state" label="State" options={socialStates} />
        <PgSelect name="brand" label="Provider" options={brands} />
      </div>
      <div class="options">
        <label class="toggle"><input type="checkbox" name="iconOnly" /><span>Icon only</span></label>
        <label class="toggle"><input type="checkbox" name="rounded" /><span>Rounded</span></label>
      </div>
      <div class="canvas" data-canvas>
        <div data-host><Fragment set:html={socialButton({ live: true })} /></div>
        <p class="chip" data-chip aria-live="polite">{socialChip({ style: 'Neutral', state: 'Default', iconOnly: false, rounded: false })}</p>
      </div>
    </form>
  </Section>

  <Section id="styles" label="Styles" desc="Neutral is dark and stands out, Stroke sits on white, White sits on a grey surface">
    <div class="grid3">
      {socialStyles.map((s) => (
        <div class="tile tile-static tile-v">
          <span class="tile-top"><span class="label muted">{s}</span></span>
          <span class="tile-body"><span class={s === 'Stroke' ? 'surface' : ''}><Fragment set:html={socialButton({ style: s })} /></span></span>
        </div>
      ))}
    </div>
  </Section>

  <Section id="brands" label="Providers" desc="Swap the logo with the Major Brand Logos instance. Neutral takes the white logo, Stroke and White the original">
    <div class="grid2">
      {(['Neutral', 'Stroke'] as const).map((s) => (
        <div class="tile tile-static tile-auto">
          <span class="tile-top"><span class="label muted">{s}</span></span>
          <span class="tile-body"><span class={s === 'Stroke' ? 'surface' : ''}><span class="tile-wrap">{brands.map((b) => <Fragment set:html={socialButton({ style: s, brand: b, iconOnly: true })} />)}</span></span></span>
        </div>
      ))}
    </div>
  </Section>

  <Section id="states" label="States and shape">
    <div class="grid4">
      {socialStates.map((st) => (
        <div class="tile tile-static tile-big">
          <span class="tile-top"><span class="label muted">{st}</span></span>
          <span class="tile-body"><Fragment set:html={socialButton({ state: st, brand: 'Apple' })} /></span>
        </div>
      ))}
      <div class="tile tile-static tile-big">
        <span class="tile-top"><span class="label muted">Icon only</span></span>
        <span class="tile-body"><Fragment set:html={socialButton({ iconOnly: true, brand: 'GitHub' })} /></span>
      </div>
      <div class="tile tile-static tile-big">
        <span class="tile-top"><span class="label muted">Rounded</span></span>
        <span class="tile-body"><Fragment set:html={socialButton({ iconOnly: true, rounded: true, brand: 'X' })} /></span>
      </div>
    </div>
  </Section>

  <Section id="usage" label="Usage" title="When to use">
    <Usage
      use={['People can sign in or sign up with an account they already have', 'A sign-in page offers two or three providers next to email', 'Space is tight and the logos are well known, use Icon only']}
      avoid={['The action is not about an account, use a Button', 'You link to a brand’s page, use a Link Button', 'More than four providers compete, pick the ones your people use']}
    />
  </Section>

  <Section id="guidance" label="Guidance" title="Do and don’t">
    <DoDont
      doText="Stack providers in one style, at the same width, with the same Login with wording"
      dontText="Don’t mix styles between providers, one looks preferred and the page looks unfinished"
    >
      <Fragment slot="do"><span class="tile-wrap"><Fragment set:html={socialButton({ style: 'Stroke', brand: 'Google' })} /><Fragment set:html={socialButton({ style: 'Stroke', brand: 'Apple' })} /></span></Fragment>
      <Fragment slot="dont"><span class="tile-wrap"><Fragment set:html={socialButton({ brand: 'Google' })} /><Fragment set:html={socialButton({ style: 'Stroke', brand: 'Apple' })} /></span></Fragment>
    </DoDont>
  </Section>

  <Section id="specs" label="Specs" title="Tokens and specs">
    <SpecsTable label="Social Button tokens and specs" rows={specs} />
  </Section>

  <Section id="related" label="Related" title="Related components">
    <Related items={[
      ['Button', 'Sign in with email'],
      ['Text Input', 'Email and password'],
      ['Brand Logos', 'Every provider logo'],
      ['Icon Button', 'Icon-only actions'],
    ]} />
  </Section>
</DocPage>
