---
import DocPage from '../../layouts/DocPage.astro';
import Section from '../../components/doc/Section.astro';
import SpecsTable from '../../components/doc/SpecsTable.astro';
import Usage from '../../components/doc/Usage.astro';
import DoDont from '../../components/doc/DoDont.astro';
import Related from '../../components/doc/Related.astro';
import PgSelect from '../../components/choice/PgSelect.astro';
import Btn from '../../components/Btn.astro';
import '../../styles/u-feedback.css';
import '../../styles/u-banner.css';
import { types, statuses, aligns, render, chip, variantCount } from '../../data/banner';

const toc: [string, string][] = [
  ['playground', 'Playground'],
  ['statuses', 'Statuses'],
  ['types', 'Types'],
  ['align', 'Alignment'],
  ['usage', 'When to use'],
  ['guidance', 'Do and don’t'],
  ['specs', 'Tokens and specs'],
  ['related', 'Related'],
];
const specs: [string, string, string][] = [
  ['Width', '—', 'Fill, full page width'],
  ['Height', '—', '44 px'],
  ['Padding', '—', '12 / 48 px'],
  ['Icon to text', 'spacing-12', '12 px'],
  ['Title to description', 'spacing-8', '8 px, with a 2 px dot between'],
  ['Title', '—', 'Inter Medium 14/20'],
  ['Description', '—', 'Inter Regular 14/20'],
  ['Link', '—', 'Inter Medium 12/16'],
  ['Icon', '—', '16 px'],
  ['Close', '—', '20 px, 48% opacity'],
  ['Filled', 'state/*/base', 'text/white-0 on the state color'],
  ['Light', 'state/*/lighter', 'state/*/base text and icons'],
  ['Stroke, outline', 'stroke/soft-200', '#EBEBEB'],
  ['Stroke, text', 'text/strong-950 + text/sub-600', '#171717 / #5C5C5C'],
  ['Stroke, dot and close', 'icon/soft-400 + icon/sub-600', '#A3A3A3 / #5C5C5C'],
];
---
<DocPage
  title="Banner"
  description="Banners announce something that affects the whole product, from maintenance to a trial ending. Explore every type, status and alignment of the Unictive banner."
  intro="Banners run across the top of the page for news that touches the whole product or account"
  toc={toc}
  meta={[['Variants', variantCount], ['Statuses', statuses.length], ['Types', types.length]]}
>
  <Section id="playground" label="Playground" desc="Pick a type, status and alignment. Close it to see it go, then bring it back">
    <form class="pg" data-playground data-kind="banner" onsubmit="return false">
      <div class="fields" data-cols="3">
        <PgSelect name="type" label="Type" options={types} value="Light" />
        <PgSelect name="status" label="Status" options={statuses} value="Info" />
        <PgSelect name="align" label="Align" options={aligns} />
      </div>
      <div class="options">
        <label class="toggle"><input type="checkbox" name="description" checked /><span>Description</span></label>
        <label class="toggle"><input type="checkbox" name="button" checked /><span>Link</span></label>
        <label class="text-field">
          <input aria-label="Title" type="text" name="title" placeholder="Sample title" maxlength="60" spellcheck="false" autocomplete="off" />
        </label>
      </div>
      <div class="canvas" data-canvas>
        <div class="canvas-fill" data-host><Fragment set:html={render({ live: true })} /></div>
        <p class="chip" data-chip aria-live="polite">{chip({ type: 'Light', status: 'Info', align: 'Center' })}</p>
        <div class="canvas-tools"><Btn size="Small" variant="Secondary" type="Neutral" label="Show again" data-restore hidden /></div>
      </div>
    </form>
  </Section>

  <Section id="statuses" label="Statuses" desc="The same five statuses as the Alert, so a color means the same thing everywhere">
    <div class="tile-stack fill">
      {statuses.map((s) => (
        <div class="tile tile-static tile-wide">
          <span class="tile-top"><span class="label muted">{s}</span></span>
          <span class="tile-body"><Fragment set:html={render({ status: s, type: 'Light' })} /></span>
        </div>
      ))}
    </div>
  </Section>

  <Section id="types" label="Types" desc="Filled for outages and anything urgent, Light for most news, Stroke when the page around it is busy">
    <div class="tile-stack fill">
      {types.map((t) => (
        <div class="tile tile-static tile-wide">
          <span class="tile-top"><span class="label muted">{t}</span></span>
          <span class="tile-body"><Fragment set:html={render({ type: t, status: 'Warning' })} /></span>
        </div>
      ))}
    </div>
  </Section>

  <Section id="align" label="Alignment" desc="Center the message on marketing and landing pages. Align it left in apps, so it lines up with the content below">
    <div class="tile-stack fill">
      {aligns.map((a) => (
        <div class="tile tile-static tile-wide">
          <span class="tile-top"><span class="label muted">{a}</span></span>
          <span class="tile-body"><Fragment set:html={render({ align: a, type: 'Stroke', status: 'Feature' })} /></span>
        </div>
      ))}
    </div>
  </Section>

  <Section id="usage" label="Usage" title="When to use">
    <Usage
      use={['The news affects the whole product or account, like planned maintenance', 'It should stay visible on every page until it’s resolved or dismissed', 'One short line and an optional link say everything']}
      avoid={['The message is about one form or card, use an Alert', 'The message needs a long explanation, link to a page or use a Modal', 'Several banners would stack up, show the most important one']}
    />
  </Section>

  <Section id="guidance" label="Guidance" title="Do and don’t">
    <DoDont
      doText="Keep it to one line: what’s happening, when, and a link for details"
      dontText="Don’t use Filled for good news or promotions, save the loudest style for problems"
    >
      <Fragment slot="do"><Fragment set:html={render({ type: 'Light', status: 'Info', align: 'Left' })} /></Fragment>
      <Fragment slot="dont"><Fragment set:html={render({ type: 'Filled', status: 'Success', align: 'Left' })} /></Fragment>
    </DoDont>
  </Section>

  <Section id="specs" label="Specs" title="Tokens and specs">
    <SpecsTable label="Banner tokens and specs" rows={specs} />
  </Section>

  <Section id="related" label="Related" title="Related components">
    <Related items={[
      ['Alert', 'Feedback inside the page'],
      ['Modal', 'Messages that need a decision'],
      ['Badge', 'Short status labels'],
      ['Button', 'Actions and links'],
    ]} />
  </Section>
</DocPage>

<script>
  import '../../scripts/feedback-page';
</script>
