---
import DocPage from '../../layouts/DocPage.astro';
import Section from '../../components/doc/Section.astro';
import SpecsTable from '../../components/doc/SpecsTable.astro';
import Usage from '../../components/doc/Usage.astro';
import DoDont from '../../components/doc/DoDont.astro';
import Related from '../../components/doc/Related.astro';
import TextInput from '../../components/TextInput.astro';
import Btn from '../../components/Btn.astro';
import CodeDocs from '../../components/doc/CodeDocs.astro';
import { classes, examples } from '../../lib/text-input-code';
import { styles, sizes, states, types, metrics, variantCount } from '../../data/text-input';

const stateName = (s: string) => (s === 'Disable' ? 'Disabled' : s);
const copyAttr = (v: Record<string, unknown>) => JSON.stringify({ style: 'Outline', size: 'Medium', state: 'Placeholder', type: 'Default', ...v });
const specs: [string, string, string][] = [
  ['Field height', '—', '48 / 40 / 32'],
  ['Padding', 'spacing-12 · 14 · 10 · 6', '12 px sides, 14 / 10 / 6 px top and bottom'],
  ['Corner radius', 'radius-8', '8 px'],
  ['Border', 'stroke/sub-300', '#DEDEDE'],
  ['Focus border', 'brand/core/base', '#1868D0'],
  ['Error border and caption', 'state/error/base', '#FB3748'],
  ['Contained fill', 'bg/weak-50', '#F7F7F7'],
  ['Contained addon fill', 'bg/soft-200', '#EBEBEB'],
  ['Placeholder', 'text/soft-400', '#A3A3A3'],
  ['Value', 'text/strong-950', '#171717'],
  ['Icon to text gap', 'spacing/medium-2x', '8 px'],
  ['Icon size', '—', '20 px · 16 px on Small'],
  ['Label style', 'Label / Medium / Small', 'Inter Medium 14/20'],
  ['Value style', 'Paragraphs / Small', 'Inter Regular 14/20'],
  ['Caption style', 'Paragraphs / Extra Small', 'Inter Regular 12/16'],
];
---
<DocPage
  script="field"
  title="Text Input"
  description="Text inputs let people enter a single line of text. Explore every type, size and state of the Unictive text input."
  intro="Text inputs let people enter and edit a single line of text, like a name, an email or an amount"
  meta={[['Variants', variantCount], ['Types', types.length]]}
>
  <Btn slot="action" size="Large" label="Copy" copy="figma" data-copy-current />
  <Section id="playground" label="Playground" desc="Pick a variant, then click into the preview to type">
    <form class="pg" data-playground onsubmit="return false">
      <div class="fields">
        {[['style', 'Style', styles], ['type', 'Type', types], ['size', 'Size', sizes], ['state', 'State', states]].map(([key, label, opts]) => (
          <label class="field">
            <span class="label muted">{label}</span>
            <span class="select">
              <select name={key as string}>
                {(opts as readonly string[]).map((o) => <option value={o} selected={o === 'Medium' || undefined}>{stateName(o)}</option>)}
              </select>
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M5 7.5L10 12.5L15 7.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
          </label>
        ))}
      </div>
      <div class="options">
        <label class="toggle"><input type="checkbox" name="label" checked /><span>Label</span></label>
        <label class="toggle"><input type="checkbox" name="required" checked /><span>Required</span></label>
        <label class="toggle"><input type="checkbox" name="optional" checked /><span>Optional hint</span></label>
        <label class="toggle"><input type="checkbox" name="caption" checked /><span>Caption</span></label>
        <label class="toggle"><input type="checkbox" name="leadIcon" checked /><span>Leading icon</span></label>
        <label class="toggle"><input type="checkbox" name="trailIcon" checked /><span>Trailing icon</span></label>
      </div>
      <div class="canvas" data-canvas>
        <div class="spec spec-field">
          <span class="measure-num" data-measure>40</span>
          <span class="measure-line" aria-hidden="true"></span>
          <div>{types.map((t) => <TextInput type={t} state={t === 'Password' ? 'Filled' : 'Placeholder'} live data-preview hidden={t !== 'Default'} />)}</div>
        </div>
        <p class="chip" data-chip aria-live="polite">Style=Outline · Type=Default · Size=Medium · State=Placeholder</p>
      </div>
      <div class="pg-foot">
        <p>Copy to Figma pastes editable auto layout layers, Copy HTML gives the markup for code. Press <kbd>⌘C</kbd> to copy to Figma</p>
        <div class="pg-actions">
          <Btn variant="Secondary" type="Neutral" label="Copy" copy="html" data-pg-copy />
          <Btn label="Copy" copy="figma" data-copy-current />
        </div>
      </div>
    </form>
  </Section>

  <Section id="types" label="Types" desc="Eight types cover prefixes, suffixes, inline actions and tags. Password ships Filled and Error only">
    <div class="grid2">
      {types.map((t, i) => (
        <button type="button" class="tile tile-field" data-copy={copyAttr({ type: t, state: t === 'Password' || t === 'Tag Input' ? 'Filled' : 'Placeholder' })} aria-label={`Copy ${t} text input to Figma`}>
          <span class="tile-top"><span class="label muted">{String(i + 1).padStart(2, '0')} / {t}</span></span>
          <span class="tile-body"><TextInput type={t} state={t === 'Password' || t === 'Tag Input' ? 'Filled' : 'Placeholder'} /></span>
          <span class="copy-hint">Copy</span>
        </button>
      ))}
    </div>
  </Section>

  <Section id="styles" label="Styles" desc="Outline sits on white surfaces, Contained fills the field for denser or tinted layouts">
    <div class="grid2">
      {styles.map((s) => (
        <button type="button" class="tile tile-field" data-copy={copyAttr({ style: s })} aria-label={`Copy ${s} text input to Figma`}>
          <span class="tile-top"><span class="label muted">{s}</span></span>
          <span class="tile-body"><TextInput variant={s} /></span>
          <span class="copy-hint">Copy</span>
        </button>
      ))}
    </div>
  </Section>

  <Section id="sizes" label="Sizes">
    <div class="grid3">
      {sizes.map((z) => (
        <button type="button" class="tile tile-field" data-copy={copyAttr({ size: z })} aria-label={`Copy ${z} text input to Figma`}>
          <span class="tile-top"><span class="big">{metrics[z].height}</span><span class="label muted">{z}</span></span>
          <span class="tile-body"><TextInput size={z} /></span>
          <span class="copy-hint">Copy</span>
        </button>
      ))}
    </div>
  </Section>

  <Section id="states" label="States" desc="Focus and Typing use the brand border, Error swaps the border and caption to the error color">
    <div class="grid3">
      {states.map((s) => (
        <button type="button" class="tile tile-field" data-copy={copyAttr({ state: s })} aria-label={`Copy ${stateName(s)} text input to Figma`}>
          <span class="tile-top"><span class="label muted">{stateName(s)}</span></span>
          <span class="tile-body"><TextInput state={s} /></span>
          <span class="copy-hint">Copy</span>
        </button>
      ))}
    </div>
  </Section>

  <Section id="usage" label="Usage" title="When to use">
    <Usage
      use={['People enter a short, single-line value like a name, an email or an amount', 'The value needs a prefix, a unit or an inline action, use a Leading or Trailing type', 'People add several short values to one field, use Tag Input']}
      avoid={['The answer can run longer than one line, use a Text Area', 'People pick from a known list of options, use a Dropdown', 'The value is a date or a range of dates, use a Date Picker']}
    />
  </Section>

  <Section id="guidance" label="Guidance" title="Do and don’t">
    <DoDont
      doText="Keep the label above the field and use the caption for hints or format rules"
      dontText="Don’t use the placeholder as the label, it disappears as soon as people type"
    >
      <Fragment slot="do"><TextInput labelText="Email" text="name@company.com" optional={false} captionText="We send the receipt to this address" leadIcon={false} trailIcon={false} /></Fragment>
      <Fragment slot="dont"><TextInput label={false} text="Email" caption={false} leadIcon={false} trailIcon={false} /></Fragment>
    </DoDont>
  </Section>

  <Section id="specs" label="Specs" title="Tokens and specs">
    <SpecsTable label="Text Input tokens and specs" rows={specs} />
  </Section>

  <CodeDocs name="Text input" classes={classes} examples={examples} />

  <Section id="related" label="Related" title="Related components">
    <Related items={[
      ['Text Area', 'Multi-line text'],
      ['Dropdown', 'Pick from a list'],
      ['Date Picker', 'Dates and ranges'],
      ['File Upload', 'Attach files'],
    ]} />
  </Section>
</DocPage>
