---
import DocPage from '../../layouts/DocPage.astro';
import Section from '../../components/doc/Section.astro';
import SpecsTable from '../../components/doc/SpecsTable.astro';
import Usage from '../../components/doc/Usage.astro';
import DoDont from '../../components/doc/DoDont.astro';
import Related from '../../components/doc/Related.astro';
import Checkbox from '../../components/Checkbox.astro';
import ChoiceLabel from '../../components/choice/ChoiceLabel.astro';
import PgSelect from '../../components/choice/PgSelect.astro';
import Btn from '../../components/Btn.astro';
import { bare, labeled, group, copyAttr } from '../../lib/figma/choice-copy';
import { sizes, states, positions, metrics, variantCount } from '../../data/checkbox';

const stateName = { Default: 'Unchecked', Select: 'Checked', Indeterminate: 'Indeterminate' } as const;
const specs: [string, string, string][] = [
  ['Control size', '—', '20 / 16'],
  ['Corner radius', '—', '4 px at Medium'],
  ['Border, unchecked', 'icon/soft-400', '#A3A3A3'],
  ['Border width', '—', '1.4 px'],
  ['Fill, checked and indeterminate', 'brand/core/base', '#1868D0'],
  ['Disabled border and fill', 'icon/disabled-300', '#D1D1D1'],
  ['Disabled box', 'bg/weak-50', '#F7F7F7'],
  ['Label width', '—', '360 px'],
  ['Control to text', 'spacing-12', '12 px'],
  ['Label to description', 'spacing-4', '4 px'],
  ['Text to link button', 'spacing-8', '8 px'],
  ['Label style', 'Label / Medium / Small', 'Inter Medium 14/20'],
  ['Description style', 'Paragraphs / Extra Small', 'Inter Regular 12/16'],
  ['Link button style', 'Label / Medium / Extra Small', 'Inter Medium 12/16'],
  ['Badge', 'Badge · Small · Light', '#ECF0FE on #1868D0'],
];
---
<DocPage
  script="choice"
  title="Checkbox"
  description="Checkboxes let people turn options on or off, alone or as several picks from a list. Explore every size and state of the Unictive checkbox."
  intro="Checkboxes let people pick any number of options from a list, or confirm a single choice like agreeing to terms"
  meta={[['Variants', variantCount], ['Component sets', 2]]}
>
  <Btn slot="action" size="Large" label="Copy to Figma" data-copy-current />
  <Section id="playground" label="Playground" desc="Pick a variant, then click the preview to check and uncheck it">
    <form class="pg" data-playground data-kind="checkbox" onsubmit="return false">
      <div class="fields">
        <PgSelect name="component" label="Component" options={['Checkbox', 'Checkbox-label']} value="Checkbox-label" />
        <PgSelect name="size" label="Size" options={sizes} />
        <PgSelect name="position" label="Position" options={positions} />
        <PgSelect name="state" label="State" options={states.map((s) => [s, stateName[s]] as [string, string])} value="Select" />
      </div>
      <div class="options">
        <label class="toggle"><input type="checkbox" name="disabled" /><span>Disabled</span></label>
        <label class="toggle"><input type="checkbox" name="description" checked /><span>Description</span></label>
        <label class="toggle"><input type="checkbox" name="badge" checked /><span>Badge</span></label>
        <label class="toggle"><input type="checkbox" name="button" checked /><span>Link button</span></label>
      </div>
      <div class="canvas" data-canvas>
        <div class="spec spec-choice">
          <span class="measure-num" data-measure>20</span>
          <span class="measure-line" aria-hidden="true"></span>
          <div>
            <div data-bare data-measure-target hidden><Checkbox live state="Select" ariaLabel="Preview checkbox" /></div>
            <div data-labeled data-measure-target>
              <ChoiceLabel live labelText="Email me product updates" descriptionText="One email a month, unsubscribe any time"><Checkbox live state="Select" /></ChoiceLabel>
            </div>
          </div>
        </div>
        <p class="chip" data-chip aria-live="polite">Checkbox-label · Position=Right · State=Select · Disable=false</p>
      </div>
      <div class="pg-foot">
        <p>Pastes into Figma as editable auto layout layers with Unictive values, click the button or press <kbd>⌘C</kbd> to copy</p>
        <Btn label="Copy to Figma" data-copy-current />
      </div>
    </form>
  </Section>

  <Section id="sizes" label="Sizes" desc="Medium sits next to body text and in forms, Small fits dense tables and lists">
    <div class="grid2">
      {sizes.map((z) => (
        <button type="button" class="tile tile-v" data-copy={copyAttr(`${z} checkboxes`, group('Checkboxes', 'HORIZONTAL', 24, states.map((s) => bare('checkbox', z, s))))} aria-label={`Copy ${z} checkboxes to Figma`}>
          <span class="tile-top"><span class="big">{metrics[z].size}</span><span class="label muted">{z}</span></span>
          <span class="tile-body"><span class="choice-pair">{states.map((s) => <Checkbox size={z} state={s} />)}</span></span>
          <span class="copy-hint">Copy</span>
        </button>
      ))}
    </div>
  </Section>

  <Section id="states" label="States" desc="Each state has a disabled twin. Indeterminate only comes from a parent whose children are partly checked">
    <div class="grid3">
      {states.map((s) => (
        <button type="button" class="tile tile-v" data-copy={copyAttr(`${stateName[s]} · Enabled and disabled`, group('Checkboxes', 'HORIZONTAL', 24, [bare('checkbox', 'Medium', s), bare('checkbox', 'Medium', s, true)]))} aria-label={`Copy ${stateName[s]} checkboxes to Figma`}>
          <span class="tile-top"><span class="label muted">{stateName[s]}</span></span>
          <span class="tile-body"><span class="choice-pair"><Checkbox state={s} /><Checkbox state={s} disabled /></span></span>
          <span class="copy-hint">Copy</span>
        </button>
      ))}
    </div>
  </Section>

  <Section id="label" label="With label" desc="Checkbox-label adds a label, an optional description, badge and link button. Position sets which side the box sits on">
    <div class="grid2">
      {positions.map((p) => (
        <button type="button" class="tile tile-big" data-copy={copyAttr(`Checkbox with label · ${p} · Checked`, { parts: [labeled('checkbox', p, 'Select', false, { label: 'Remember this device', desc: 'Skip the code on this browser for 30 days' })] })} aria-label={`Copy checkbox with label, position ${p}, to Figma`}>
          <span class="tile-top"><span class="label muted">Position {p}</span></span>
          <span class="tile-body"><ChoiceLabel position={p} labelText="Remember this device" descriptionText="Skip the code on this browser for 30 days"><Checkbox state="Select" /></ChoiceLabel></span>
          <span class="copy-hint">Copy</span>
        </button>
      ))}
    </div>
  </Section>

  <Section id="select-all" label="Pattern" title="Select all" desc="Try it: the parent shows Indeterminate while only some children are checked, and checks or clears them all on click">
    <div class="canvas">
      <div class="choice-stack" data-select-all>
        <ChoiceLabel live position="Left" labelText="All notifications" description={false} badge={false} button={false} data-parent><Checkbox live /></ChoiceLabel>
        <div class="choice-stack tight choice-indent">
          {['Comments', 'Mentions', 'Weekly summary'].map((t, i) => (
            <ChoiceLabel live position="Left" labelText={t} description={false} badge={false} button={false} data-child><Checkbox live state={i === 0 ? 'Select' : 'Default'} /></ChoiceLabel>
          ))}
        </div>
      </div>
    </div>
  </Section>

  <Section id="usage" label="Usage" title="When to use">
    <Usage
      use={['People can pick any number of options from a list, including none', 'A single option needs explicit consent, like accepting terms before signing up', 'A parent option controls a group of children, show Indeterminate when only some are on']}
      avoid={['Only one option can be picked, use a Radio Group', 'The change applies right away, like turning on notifications, use a Switch', 'The list is long and people pick one item, use a Dropdown']}
    />
  </Section>

  <Section id="guidance" label="Guidance" title="Do and don’t">
    <DoDont
      doText="Write labels as positive statements, so checking the box means yes"
      dontText="Don’t use negative labels that make people uncheck to opt in"
    >
      <Fragment slot="do"><ChoiceLabel position="Left" labelText="Send me order updates" description={false} badge={false} button={false}><Checkbox state="Select" /></ChoiceLabel></Fragment>
      <Fragment slot="dont"><ChoiceLabel position="Left" labelText="Don’t stop sending me updates" description={false} badge={false} button={false}><Checkbox /></ChoiceLabel></Fragment>
    </DoDont>
  </Section>

  <Section id="specs" label="Specs" title="Tokens and specs">
    <SpecsTable label="Checkbox tokens and specs" rows={specs} />
  </Section>

  <Section id="related" label="Related" title="Related components">
    <Related items={[
      ['Radio Group', 'Pick one of several'],
      ['Switch', 'Turn a setting on or off'],
      ['Dropdown', 'Pick from a long list'],
      ['Text Area', 'Write longer text'],
    ]} />
  </Section>
</DocPage>
