---
import DocPage from '../../layouts/DocPage.astro';
import Section from '../../components/doc/Section.astro';
import SpecsTable from '../../components/doc/SpecsTable.astro';
import Usage from '../../components/doc/Usage.astro';
import DoDont from '../../components/doc/DoDont.astro';
import Related from '../../components/doc/Related.astro';
import PgSelect from '../../components/choice/PgSelect.astro';
import Btn from '../../components/Btn.astro';
import '../../styles/u-stepper.css';
import { indicators, sizes, states, layouts, steps, render, indicator, chip, variantCount } from '../../data/stepper';

const three = steps.slice(0, 3);
const specs: [string, string, string][] = [
  ['Indicator size', '—', '40 / 32 px'],
  ['Indicator radius', 'radius-full', '999 px, 12 / 8 px when not rounded'],
  ['Number', '—', 'Inter Medium 16/24, 14/20 at Small'],
  ['Default', 'bg/sub-300', '#D1D1D1'],
  ['Active', 'state/information/base', '#335CFF'],
  ['Finish', 'state/success/base', '#1FC16B'],
  ['Stroke, default number', 'text/soft-400', '#A3A3A3'],
  ['Check icon', 'icon/white-0', '24 / 20 px, 2 px stroke'],
  ['Shape-01 dot', '—', '24 / 20 px'],
  ['Shape-02 dot', 'bg/white-0', '16 / 12 px'],
  ['Bar track', 'bg/soft-200', '#EBEBEB, 2 px, 4 px for type 04'],
  ['Label', 'text/sub-600', 'Inter Regular 12/16, 10/12 at Small'],
  ['Step name', 'text/strong-950', 'Inter Medium 14/20, 12/16 at Small'],
  ['Step name, default', 'text/sub-600', '#5C5C5C'],
  ['Badge', 'brand/core/lighter', 'Inter Medium 10/12, brand/core/base text'],
  ['Indicator to text', 'spacing-12', '12 px'],
  ['Vertical 02, active card', 'bg/weak-50 + stroke/soft-200', '16 padding, 16 radius'],
];
---
<DocPage
  script="nav"
  title="Stepper"
  description="Steppers show progress through a task split into steps, like onboarding or checkout. Explore every indicator, layout and size of the Unictive stepper."
  intro="Steppers break a long task into steps and show people what’s done, where they are and what’s left"
  meta={[['Variants', variantCount], ['Indicators', indicators.length], ['Layouts', layouts.length]]}
>
  <Section id="playground" label="Playground" desc="Pick a layout and indicator, then step through with Back and Next, or click a finished step to go back to it">
    <form class="pg" data-playground data-kind="stepper" onsubmit="return false">
      <div class="fields">
        <PgSelect name="layout" label="Layout" options={layouts} />
        <PgSelect name="indicator" label="Indicator" options={indicators} />
        <PgSelect name="size" label="Size" options={sizes} />
        <PgSelect name="rounded" label="Rounded" options={[['true', 'True'], ['false', 'False']]} />
      </div>
      <div class="options">
        <label class="toggle"><input type="checkbox" name="badge" checked /><span>Badge</span></label>
      </div>
      <div class="canvas canvas-tall" data-canvas>
        <div class="canvas-fill"><div class="surface" data-host><Fragment set:html={render({ live: true })} /></div></div>
        <p class="chip" data-chip aria-live="polite">{chip({ layout: 'h01', type: 'Filled', size: 'Large', rounded: true })} · Step 2 of 4</p>
        <div class="canvas-tools">
          <Btn size="Small" variant="Secondary" type="Neutral" label="Back" data-step-act="back" />
          <Btn size="Small" label="Next" data-step-act="next" />
        </div>
      </div>
    </form>
  </Section>

  <Section id="indicators" label="Indicators" desc="Step-variant marks each step Default, Active or Finish. Filled reads best at a glance, Stroke is lighter, the shapes drop the number for short flows">
    <div class="grid2">
      {indicators.map((t) => (
        <div class="tile tile-static tile-v">
          <span class="tile-top"><span class="label muted">{t}</span></span>
          <span class="tile-body"><span class="surface"><span class="tile-row">{states.map((s, i) => <Fragment set:html={indicator(s, i + 1, { type: t })} />)}</span></span></span>
        </div>
      ))}
    </div>
  </Section>

  <Section id="layouts" label="Layouts" desc="Horizontal steppers sit above a form or page. Vertical ones fit side panels and long setups where each step needs room">
    <div class="tile-stack">
      {layouts.map(([l, name]) => (
        <div class="tile tile-static tile-wide">
          <span class="tile-top"><span class="label muted">{name}</span></span>
          <span class="tile-body"><span class="surface"><Fragment set:html={render({ layout: l, steps: l.startsWith('v') ? three : steps, badge: false })} /></span></span>
        </div>
      ))}
    </div>
  </Section>

  <Section id="sizes" label="Sizes" desc="Large for full page flows, Small for dialogs and side panels">
    <div class="grid2">
      {sizes.map((z) => (
        <div class="tile tile-static tile-big">
          <span class="tile-top"><span class="big">{z === 'Large' ? 40 : 32}</span><span class="label muted">{z}</span></span>
          <span class="tile-body"><span class="surface"><Fragment set:html={render({ layout: 'h01', size: z, steps: three, badge: false })} /></span></span>
        </div>
      ))}
    </div>
  </Section>

  <Section id="usage" label="Usage" title="When to use">
    <Usage
      use={['A task has three to six steps that happen in a fixed order', 'People benefit from knowing how much is left, like onboarding or checkout', 'Each step is a screen or panel of its own, with a Back and Next']}
      avoid={['People can do the parts in any order, use a Tab Menu', 'There are only two steps, a page title and a button are enough', 'You show how far a single upload or process has gone, use a Progress Bar']}
    />
  </Section>

  <Section id="guidance" label="Guidance" title="Do and don’t">
    <DoDont
      doText="Name each step with a short noun, so people know what’s coming before they get there"
      dontText="Don’t leave every step unnamed, numbers alone don’t say what’s next"
    >
      <Fragment slot="do"><Fragment set:html={render({ layout: 'h02', size: 'Small', steps: three.slice(0, 2), badge: false })} /></Fragment>
      <Fragment slot="dont"><Fragment set:html={render({ layout: 'h02', size: 'Small', steps: [{ label: 'Step 01', name: 'Step' }, { label: 'Step 02', name: 'Step' }], badge: false })} /></Fragment>
    </DoDont>
  </Section>

  <Section id="specs" label="Specs" title="Tokens and specs">
    <SpecsTable label="Stepper tokens and specs" rows={specs} />
  </Section>

  <Section id="related" label="Related" title="Related components">
    <Related items={[
      ['Progress Bar', 'Show how far a process is'],
      ['Tab Menu', 'Switch views in any order'],
      ['Breadcrumbs', 'Show where a page sits'],
      ['Button', 'Back and Next actions'],
    ]} />
  </Section>
</DocPage>
