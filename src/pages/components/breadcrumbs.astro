---
import DocPage from '../../layouts/DocPage.astro';
import Section from '../../components/doc/Section.astro';
import SpecsTable from '../../components/doc/SpecsTable.astro';
import Usage from '../../components/doc/Usage.astro';
import DoDont from '../../components/doc/DoDont.astro';
import Related from '../../components/doc/Related.astro';
import PgSelect from '../../components/choice/PgSelect.astro';
import Btn from '../../components/Btn.astro';
import CodeDocs from '../../components/doc/CodeDocs.astro';
import { breadcrumbCode as code } from '../../lib/nav-code';
import '../../styles/u-breadcrumbs.css';
import { types, counts, render, chip, variantCount, baseCount } from '../../data/breadcrumbs';

const states: [name: string, note: string][] = [
  ['Default', 'Parent pages, text/sub-600'],
  ['Hover', 'Pointer over a parent, text/strong-950'],
  ['Active', 'The current page, brand and Medium'],
];
const specs: [string, string, string][] = [
  ['Item text', '—', 'Inter Regular 14/20, −0.6%'],
  ['Item text, default', 'text/sub-600', '#5C5C5C'],
  ['Item text, hover', 'text/strong-950', '#171717'],
  ['Item text, active', 'brand/core/base', '#1868D0'],
  ['Active weight', '—', 'Inter Medium'],
  ['Separator', 'icon/soft-400', '#A3A3A3'],
  ['Separator size', '—', '12 px, Slash 16 px'],
  ['Gap between items', 'spacing-12', '12 px'],
  ['Icon to text', 'spacing-6', '6 px'],
  ['Item icon', '—', '16 px, 1.4 stroke'],
  ['Rounded item height', '—', '28 px'],
  ['Rounded item padding', '—', '4 / 12 px'],
  ['Rounded item fill', 'bg/white-0', '#FFFFFF'],
  ['Rounded item stroke', 'stroke/soft-200', '#EBEBEB'],
  ['Rounded active stroke', 'brand/core/base', '#1868D0'],
  ['Corner radius', 'radius-full', '999 px'],
];
---
<DocPage
  script="nav"
  title="Breadcrumbs"
  description="Breadcrumbs show where a page sits in the hierarchy and link back to its parents. Explore every separator, style and state of the Unictive breadcrumbs."
  intro="Breadcrumbs show where a page sits in the site and let people jump back to any parent in one click"
  meta={[['Variants', variantCount], ['Base items', baseCount], ['Items', '2–5']]}
>
  <Btn slot="action" size="Large" label="Copy" copy="figma" data-copy-current />
  <Section id="playground" label="Playground" desc="Pick a variant, then click a parent crumb to go back up the trail">
    <form class="pg" data-playground data-kind="breadcrumbs" onsubmit="return false">
      <div class="fields" data-cols="3">
        <PgSelect name="type" label="Separator" options={types} />
        <PgSelect name="count" label="Items" options={counts} value="4" />
        <PgSelect name="rounded" label="Rounded" options={[['false', 'False'], ['true', 'True']]} />
      </div>
      <div class="options">
        <label class="toggle"><input type="checkbox" name="icon" checked /><span>Home icon</span></label>
        <label class="toggle"><input type="checkbox" name="dropdown" /><span>Dropdown on current</span></label>
      </div>
      <div class="canvas" data-canvas>
        <div class="canvas-fill" data-host><Fragment set:html={render({ count: 4, icon: true, live: true })} /></div>
        <p class="chip" data-chip aria-live="polite">{chip({ type: 'Arrow', count: 4, rounded: false })}</p>
      </div>
      <div class="pg-foot">
        <p>Copy to Figma pastes editable auto layout layers, Copy HTML gives the markup for code. Press <kbd>⌘C</kbd> to copy to Figma</p>
        <div class="pg-actions">
          <Btn variant="Secondary" type="Neutral" label="Copy" copy="html" data-pg-copy />
          <Btn label="Copy" copy="figma" data-copy-current />
        </div>
      </div>
    </form>
  </Section>

  <Section id="types" label="Separators" desc="Arrow is the default. Double Arrow and Slash suit dense headers, Dot suits short trails in cards and panels. Keep one separator across a product">
    <div class="grid2">
      {types.map((t) => (
        <div class="tile tile-static tile-v">
          <span class="tile-top"><span class="label muted">{t}</span></span>
          <span class="tile-body"><Fragment set:html={render({ type: t, count: 3 })} /></span>
        </div>
      ))}
    </div>
  </Section>

  <Section id="styles" label="Styles" desc="Plain items sit in page headers. Rounded items wrap each crumb in a 28 px pill, for toolbars and places where the trail needs to read as buttons">
    <div class="grid2">
      {[false, true].map((r) => (
        <div class="tile tile-static tile-v">
          <span class="tile-top"><span class="label muted">Rounded={String(r)}</span></span>
          <span class="tile-body"><Fragment set:html={render({ count: 3, rounded: r, icon: true })} /></span>
        </div>
      ))}
    </div>
  </Section>

  <Section id="states" label="States" desc="Parents are Default and darken on hover. The last item is Active, it marks the current page and can open a Dropdown of sibling pages">
    <div class="grid3">
      {states.map(([name, note]) => (
        <div class="tile tile-static tile-big">
          <span class="tile-top"><span class="label muted">{name}</span></span>
          <span class="tile-body">
            <span class="tile-stack center">
              {[false, true].map((r) => (
                <Fragment set:html={render({ count: 1, rounded: r, icon: true, labels: ['Home'], current: name === 'Active', dropdown: name === 'Active', force: name === 'Hover' ? { 0: 'hover' } : {} })} />
              ))}
            </span>
          </span>
          <span class="label muted">{note}</span>
        </div>
      ))}
    </div>
  </Section>

  <Section id="usage" label="Usage" title="When to use">
    <Usage
      use={['The site has three or more levels and people land deep from search or links', 'People need to move up to a parent page or category quickly', 'The page title alone doesn’t say where the page belongs']}
      avoid={['The product is flat, with one or two levels, the main navigation is enough', 'The steps happen in order, like a checkout, use a Stepper', 'People switch between views of the same page, use a Tab Menu']}
    />
  </Section>

  <Section id="guidance" label="Guidance" title="Do and don’t">
    <DoDont
      doText="Start at the top level and end with the current page, so the trail reads like a path"
      dontText="Don’t show a trail of one item, or repeat the page title twice"
    >
      <Fragment slot="do"><Fragment set:html={render({ count: 3, labels: ['Home', 'Orders', 'INV-2041'] })} /></Fragment>
      <Fragment slot="dont"><Fragment set:html={render({ count: 2, labels: ['Orders', 'Orders'] })} /></Fragment>
    </DoDont>
  </Section>

  <Section id="specs" label="Specs" title="Tokens and specs">
    <SpecsTable label="Breadcrumbs tokens and specs" rows={specs} />
  </Section>

  <CodeDocs name="Breadcrumbs" classes={code.classes} examples={code.examples} />

  <Section id="related" label="Related" title="Related components">
    <Related items={[
      ['Tab Menu', 'Switch views on one page'],
      ['Stepper', 'Show progress through steps'],
      ['Pagination', 'Move through long lists'],
      ['Dropdown', 'Pick a sibling page'],
    ]} />
  </Section>
</DocPage>
