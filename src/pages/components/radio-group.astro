---
import DocPage from '../../layouts/DocPage.astro';
import Section from '../../components/doc/Section.astro';
import SpecsTable from '../../components/doc/SpecsTable.astro';
import Usage from '../../components/doc/Usage.astro';
import DoDont from '../../components/doc/DoDont.astro';
import Related from '../../components/doc/Related.astro';
import RadioGroup from '../../components/RadioGroup.astro';
import ChoiceLabel from '../../components/choice/ChoiceLabel.astro';
import PgSelect from '../../components/choice/PgSelect.astro';
import Btn from '../../components/Btn.astro';
import CodeDocs from '../../components/doc/CodeDocs.astro';
import { radio as code } from '../../lib/choice-code';
import { bare, labeled, group, copyAttr } from '../../lib/figma/choice-copy';
import { sizes, positions, metrics, variantCount } from '../../data/radio-group';

const states: [name: string, selected: boolean, disabled: boolean][] = [
  ['Unselected', false, false],
  ['Selected', true, false],
  ['Disabled', false, true],
  ['Disabled selected', true, true],
];
const options = ['Standard delivery', 'Express delivery', 'Pick up in store'];
const notes = ['3 to 5 working days, free', 'Next working day, Rp25.000', 'Ready in 2 hours at the nearest store'];
const specs: [string, string, string][] = [
  ['Control size', '—', '20 / 16'],
  ['Circle', '—', '16 / 12.8 px'],
  ['Ring, unselected', 'icon/soft-400', '1 px #A3A3A3'],
  ['Ring, selected', 'brand/core/base', '4 px #1868D0'],
  ['Disabled ring', 'icon/disabled-300', '#D1D1D1'],
  ['Label width', '—', '360 px'],
  ['Control to text', 'spacing-12', '12 px'],
  ['Label to description', 'spacing-4', '4 px'],
  ['Text to link button', 'spacing-8', '8 px'],
  ['Label style', 'Label / Medium / Small', 'Inter Medium 14/20'],
  ['Description style', 'Paragraphs / Extra Small', 'Inter Regular 12/16'],
  ['Link button style', 'Label / Medium / Extra Small', 'Inter Medium 12/16'],
  ['Badge', 'Badge · Small · Light', '#ECF0FE on #1868D0'],
];
---
<DocPage
  script="choice"
  title="Radio Group"
  description="Radio groups let people pick exactly one option from a short list. Explore every size and state of the Unictive radio."
  intro="Radio groups let people pick exactly one option from a short list where every choice should stay visible"
  meta={[['Variants', variantCount], ['Component sets', 2]]}
>
  <Btn slot="action" size="Large" label="Copy" copy="figma" data-copy-current />
  <Section id="playground" label="Playground" desc="Pick a variant, then click an option in the preview to select it">
    <form class="pg" data-playground data-kind="radio" onsubmit="return false">
      <div class="fields">
        <PgSelect name="component" label="Component" options={['Radio-group', 'Radio-group-label']} value="Radio-group-label" />
        <PgSelect name="size" label="Size" options={sizes} />
        <PgSelect name="position" label="Position" options={positions} value="Left" />
        <PgSelect name="selected" label="Selected" options={[['none', 'None'], ['1', 'Option 1'], ['2', 'Option 2'], ['3', 'Option 3']]} value="1" />
      </div>
      <div class="options">
        <label class="toggle"><input type="checkbox" name="disabled" /><span>Disabled</span></label>
        <label class="toggle"><input type="checkbox" name="description" checked /><span>Description</span></label>
        <label class="toggle"><input type="checkbox" name="badge" /><span>Badge</span></label>
        <label class="toggle"><input type="checkbox" name="button" /><span>Link button</span></label>
      </div>
      <div class="canvas" data-canvas>
        <div role="radiogroup" aria-label="Preview options" class="choice-stack" data-bare hidden>
          {[1, 2, 3].map((n) => <RadioGroup live name="pg-bare" value={String(n)} selected={n === 1} ariaLabel={`Option ${n}`} />)}
        </div>
        <div role="radiogroup" aria-label="Preview options" class="choice-stack" data-labeled>
          {[1, 2, 3].map((n) => (
            <ChoiceLabel live position="Left" labelText={`Option ${n}`} descriptionText={notes[n - 1]} badge={false} button={false}>
              <RadioGroup live name="pg-label" value={String(n)} selected={n === 1} />
            </ChoiceLabel>
          ))}
        </div>
        <p class="chip" data-chip aria-live="polite">Radio-group-label · Position=Left · Selected=Option 1 · Disable=false</p>
      </div>
      <div class="pg-foot">
        <p>Copy to Figma pastes editable auto layout layers, Copy HTML gives the markup for code. Press <kbd>⌘C</kbd> to copy to Figma</p>
        <div class="pg-actions">
          <Btn variant="Secondary" type="Neutral" label="Copy" copy="html" data-pg-copy />
          <Btn label="Copy" copy="figma" data-copy-current />
        </div>
      </div>
    </form>
  </Section>

  <Section id="sizes" label="Sizes" desc="Medium sits next to body text and in forms, Small fits dense tables and filters">
    <div class="grid2">
      {sizes.map((z) => (
        <button type="button" class="tile tile-v" data-copy={copyAttr(`${z} radios`, group('Radios', 'HORIZONTAL', 24, [bare('radio', z, 'false'), bare('radio', z, 'true')]))} aria-label={`Copy ${z} radios to Figma`}>
          <span class="tile-top"><span class="big">{metrics[z].size}</span><span class="label muted">{z}</span></span>
          <span class="tile-body"><span class="choice-pair"><RadioGroup size={z} /><RadioGroup size={z} selected /></span></span>
          <span class="copy-hint">Copy</span>
        </button>
      ))}
    </div>
  </Section>

  <Section id="states" label="States" desc="Selected thickens the ring to 4 px in brand blue. Disabled keeps the shape and greys it out">
    <div class="grid4">
      {states.map(([name, selected, disabled]) => (
        <button type="button" class="tile tile-v" data-copy={copyAttr(`Radio · ${name}`, { parts: [bare('radio', 'Medium', String(selected), disabled)] })} aria-label={`Copy ${name} radio to Figma`}>
          <span class="tile-top"><span class="label muted">{name}</span></span>
          <span class="tile-body"><RadioGroup selected={selected} disabled={disabled} /></span>
          <span class="copy-hint">Copy</span>
        </button>
      ))}
    </div>
  </Section>

  <Section id="label" label="With label" desc="Radio-group-label adds a label, an optional description, badge and link button. Position sets which side the radio sits on">
    <div class="grid2">
      {positions.map((p) => (
        <button type="button" class="tile tile-big" data-copy={copyAttr(`Radio with label · ${p} · Selected`, { parts: [labeled('radio', p, 'true', false, { label: 'Express delivery', desc: 'Next working day, Rp25.000', badge: 'Popular' })] })} aria-label={`Copy radio with label, position ${p}, to Figma`}>
          <span class="tile-top"><span class="label muted">Position {p}</span></span>
          <span class="tile-body"><ChoiceLabel position={p} labelText="Express delivery" descriptionText="Next working day, Rp25.000" badgeText="Popular"><RadioGroup selected /></ChoiceLabel></span>
          <span class="copy-hint">Copy</span>
        </button>
      ))}
    </div>
  </Section>

  <Section id="usage" label="Usage" title="When to use">
    <Usage
      use={['People must pick exactly one option and comparing them side by side helps', 'There are two to five options, short enough to show them all at once', 'One option is a sensible default, select it from the start']}
      avoid={['People can pick more than one option, use a Checkbox', 'The list is long or the options are obvious, use a Dropdown', 'A single setting turns on or off right away, use a Switch']}
    />
  </Section>

  <Section id="guidance" label="Guidance" title="Do and don’t">
    <DoDont
      doText="Stack options vertically and keep each label short, so the group scans in one pass"
      dontText="Don’t leave a single radio on its own, people can’t unselect it"
    >
      <Fragment slot="do">
        <div class="choice-stack tight">
          {options.map((o, i) => <ChoiceLabel position="Left" labelText={o} description={false} badge={false} button={false}><RadioGroup selected={i === 0} /></ChoiceLabel>)}
        </div>
      </Fragment>
      <Fragment slot="dont"><ChoiceLabel position="Left" labelText="I agree to the terms" description={false} badge={false} button={false}><RadioGroup /></ChoiceLabel></Fragment>
    </DoDont>
  </Section>

  <Section id="specs" label="Specs" title="Tokens and specs">
    <SpecsTable label="Radio Group tokens and specs" rows={specs} />
  </Section>

  <CodeDocs name="Radio" classes={code.classes} examples={code.examples} />

  <Section id="related" label="Related" title="Related components">
    <Related items={[
      ['Checkbox', 'Pick any number'],
      ['Dropdown', 'Pick from a long list'],
      ['Switch', 'Turn a setting on or off'],
      ['Rating', 'Score an experience'],
    ]} />
  </Section>
</DocPage>
