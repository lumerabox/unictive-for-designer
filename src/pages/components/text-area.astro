---
import DocPage from '../../layouts/DocPage.astro';
import Section from '../../components/doc/Section.astro';
import SpecsTable from '../../components/doc/SpecsTable.astro';
import Usage from '../../components/doc/Usage.astro';
import DoDont from '../../components/doc/DoDont.astro';
import Related from '../../components/doc/Related.astro';
import TextArea from '../../components/TextArea.astro';
import Btn from '../../components/Btn.astro';
import CodeDocs from '../../components/doc/CodeDocs.astro';
import { classes, examples } from '../../lib/text-area-code';
import { styles, sizes, states, metrics, maxLength, variantCount } from '../../data/text-area';

const stateName = (s: string) => (s === 'Disable' ? 'Disabled' : s);
const copyAttr = (v: Record<string, unknown>) => JSON.stringify({ style: 'Outline', size: 'Large', state: 'Placeholder', ...v });
const specs: [string, string, string][] = [
  ['Field height', '—', '120 / 80'],
  ['Frame padding', 'spacing-2', '2 px'],
  ['Text padding', 'spacing-10 · spacing-8', '10 px sides, 8 px top and bottom'],
  ['Corner radius', 'radius-8', '8 px'],
  ['Border', 'stroke/sub-300', '#DEDEDE'],
  ['Focus border', 'brand/core/base', '#1868D0'],
  ['Error border and caption', 'state/error/base', '#FB3748'],
  ['Contained fill', 'bg/weak-50', '#F7F7F7'],
  ['Placeholder', 'text/soft-400', '#A3A3A3'],
  ['Value', 'text/strong-950', '#171717'],
  ['Resize handle', '—', '12 px, bottom right'],
  ['Value style', 'Paragraphs / Small', 'Inter Regular 14/20'],
  ['Caption style', 'Paragraphs / Extra Small', 'Inter Regular 12/16'],
  ['Counter style', 'Paragraphs / Super Small', 'Inter Regular 10/12'],
];
---
<DocPage
  script="field"
  title="Text Area"
  description="Text areas let people write longer, multi-line text. Explore every size and state of the Unictive text area."
  intro="Text areas let people write longer text across several lines, like a note, a description or feedback"
  meta={[['Variants', variantCount], ['Limit', `${maxLength} characters`]]}
>
  <Btn slot="action" size="Large" label="Copy" copy="figma" data-copy-current />
  <Section id="playground" label="Playground" desc="Pick a variant, then click into the preview to type">
    <form class="pg" data-playground onsubmit="return false">
      <div class="fields" data-cols="3">
        {[['style', 'Style', styles], ['size', 'Size', sizes], ['state', 'State', states]].map(([key, label, opts]) => (
          <label class="field">
            <span class="label muted">{label}</span>
            <span class="select">
              <select name={key as string}>
                {(opts as readonly string[]).map((o) => <option value={o}>{stateName(o)}</option>)}
              </select>
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M5 7.5L10 12.5L15 7.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
          </label>
        ))}
      </div>
      <div class="options">
        <label class="toggle"><input type="checkbox" name="label" checked /><span>Label</span></label>
        <label class="toggle"><input type="checkbox" name="required" checked /><span>Required</span></label>
        <label class="toggle"><input type="checkbox" name="optional" checked /><span>Optional hint</span></label>
        <label class="toggle"><input type="checkbox" name="caption" checked /><span>Caption</span></label>
        <label class="toggle"><input type="checkbox" name="counter" checked /><span>Counter</span></label>
      </div>
      <div class="canvas" data-canvas>
        <div class="spec spec-field">
          <span class="measure-num" data-measure>120</span>
          <span class="measure-line" aria-hidden="true"></span>
          <div><TextArea live data-preview /></div>
        </div>
        <p class="chip" data-chip aria-live="polite">Style=Outline · Size=Large · State=Placeholder</p>
      </div>
      <div class="pg-foot">
        <p>Copy to Figma pastes editable auto layout layers, Copy HTML gives the markup for code. Press <kbd>⌘C</kbd> to copy to Figma</p>
        <div class="pg-actions">
          <Btn variant="Secondary" type="Neutral" label="Copy" copy="html" data-pg-copy />
          <Btn label="Copy" copy="figma" data-copy-current />
        </div>
      </div>
    </form>
  </Section>

  <Section id="styles" label="Styles" desc="Outline sits on white surfaces, Contained fills the field for denser or tinted layouts">
    <div class="grid2">
      {styles.map((s) => (
        <button type="button" class="tile tile-area" data-copy={copyAttr({ style: s })} aria-label={`Copy ${s} text area to Figma`}>
          <span class="tile-top"><span class="label muted">{s}</span></span>
          <span class="tile-body"><TextArea variant={s} /></span>
          <span class="copy-hint">Copy</span>
        </button>
      ))}
    </div>
  </Section>

  <Section id="sizes" label="Sizes">
    <div class="grid2">
      {sizes.map((z) => (
        <button type="button" class="tile tile-area" data-copy={copyAttr({ size: z })} aria-label={`Copy ${z} text area to Figma`}>
          <span class="tile-top"><span class="big">{metrics[z].height}</span><span class="label muted">{z}</span></span>
          <span class="tile-body"><TextArea size={z} /></span>
          <span class="copy-hint">Copy</span>
        </button>
      ))}
    </div>
  </Section>

  <Section id="states" label="States" desc="Focus and Typing use the brand border, Error swaps the border and caption to the error color">
    <div class="grid3">
      {states.map((s) => (
        <button type="button" class="tile tile-area" data-copy={copyAttr({ size: 'Small', state: s })} aria-label={`Copy ${stateName(s)} text area to Figma`}>
          <span class="tile-top"><span class="label muted">{stateName(s)}</span></span>
          <span class="tile-body"><TextArea size="Small" state={s} /></span>
          <span class="copy-hint">Copy</span>
        </button>
      ))}
    </div>
  </Section>

  <Section id="usage" label="Usage" title="When to use">
    <Usage
      use={['People write free text that can run past one line, like a note or a description', 'The answer length varies and people need room to review what they wrote', 'There is a character limit, show it with the counter']}
      avoid={['The value fits on one line, like a name or an email, use a Text Input', 'People pick from known answers, use a Dropdown or a Radio Group', 'The content needs formatting like bold or lists, use a rich text editor']}
    />
  </Section>

  <Section id="guidance" label="Guidance" title="Do and don’t">
    <DoDont
      doText="Size the field to the answer you expect and show the limit with the counter"
      dontText="Don’t use a text area for short, single-line values, use a Text Input"
    >
      <Fragment slot="do"><TextArea labelText="Feedback" text="Tell us what worked and what didn’t" optional={false} captionText="Visible to the design team only" /></Fragment>
      <Fragment slot="dont"><TextArea size="Small" labelText="Email" text="name@company.com" optional={false} caption={false} counter={false} /></Fragment>
    </DoDont>
  </Section>

  <Section id="specs" label="Specs" title="Tokens and specs">
    <SpecsTable label="Text Area tokens and specs" rows={specs} />
  </Section>

  <CodeDocs name="Text area" classes={classes} examples={examples} />

  <Section id="related" label="Related" title="Related components">
    <Related items={[
      ['Text Input', 'Single-line text'],
      ['Dropdown', 'Pick from a list'],
      ['File Upload', 'Attach files'],
      ['Rating', 'Score an experience'],
    ]} />
  </Section>
</DocPage>
