---
import DocPage from '../../layouts/DocPage.astro';
import Section from '../../components/doc/Section.astro';
import SpecsTable from '../../components/doc/SpecsTable.astro';
import Usage from '../../components/doc/Usage.astro';
import DoDont from '../../components/doc/DoDont.astro';
import Related from '../../components/doc/Related.astro';
import PgSelect from '../../components/choice/PgSelect.astro';
import '../../styles/u-pagination.css';
import { types, sizes, typeName, metrics, render, part, chip, variantCount, partCount } from '../../data/pagination';

const toc: [string, string][] = [
  ['playground', 'Playground'],
  ['types', 'Types'],
  ['sizes', 'Sizes'],
  ['states', 'States'],
  ['usage', 'When to use'],
  ['guidance', 'Do and don’t'],
  ['specs', 'Tokens and specs'],
  ['related', 'Related'],
];
const typeNotes: Record<string, string> = {
  '01': 'Tables where people set how many rows they see',
  '02': 'Lists where the total count matters',
  '03': 'Feeds and short lists, previous and next only',
};
const states: [kind: 'num' | 'act', state: 'default' | 'hover' | 'select' | 'disable', name: string][] = [
  ['num', 'default', 'Number · Default'],
  ['num', 'hover', 'Number · Hover'],
  ['num', 'select', 'Number · Select'],
  ['act', 'default', 'Action · Default'],
  ['act', 'hover', 'Action · Hover'],
  ['act', 'disable', 'Action · Disable'],
];
const specs: [string, string, string][] = [
  ['Height', '—', '40 / 32 / 24 px'],
  ['Corner radius', '—', '12 / 10 / 8 px, Small action 6 px'],
  ['Text', '—', 'Inter Medium 18/24, 16/24, 12/16'],
  ['Number text, Small', '—', 'Inter Medium 14/20'],
  ['Text', 'text/strong-950', '#171717'],
  ['Hover', 'bg/weak-50', '#F7F7F7'],
  ['Current page outline', 'stroke/soft-200', '#EBEBEB'],
  ['Disabled action', 'text/soft-400', '#A3A3A3'],
  ['Result count', 'text/sub-600', '#5C5C5C'],
  ['Action padding', '—', '8 / 12, icon side 10 (Large)'],
  ['Icon', '—', '16 px, 12 px at Small'],
  ['Gap inside a group', 'spacing-4', '4 px'],
  ['Gap between groups', 'spacing-16', '16 px'],
  ['Rows select', 'bg/white-0 + stroke/soft-200', '100 px wide, sub-300 when open'],
  ['Rows options', '—', '10, 25, 50, 100'],
];
---
<DocPage
  script="nav"
  title="Pagination"
  description="Pagination splits long lists and tables into pages and lets people move between them. Explore every type, size and state of the Unictive pagination."
  intro="Pagination splits a long list or table into pages, and shows people where they are and how much is left"
  toc={toc}
  meta={[['Variants', variantCount], ['Parts', partCount], ['Sizes', sizes.length]]}
>
  <Section id="playground" label="Playground" desc="Pick a variant, then page through 120 results or change the rows per page">
    <form class="pg" data-playground data-kind="pagination" onsubmit="return false">
      <div class="fields" data-cols="3">
        <PgSelect name="type" label="Type" options={types.map((t) => [t, `${t} · ${typeName[t]}`] as [string, string])} />
        <PgSelect name="size" label="Size" options={sizes} value="Medium" />
        <PgSelect name="items" label="Results" options={[['50', '50 results'], ['120', '120 results'], ['480', '480 results']]} value="120" />
      </div>
      <div class="canvas" data-canvas>
        <div class="canvas-fill" data-host><Fragment set:html={render({ size: 'Medium', live: true })} /></div>
        <p class="chip" data-chip aria-live="polite">{chip({ type: '01', size: 'Medium' })} · Page 1 of 12</p>
      </div>
    </form>
  </Section>

  <Section id="types" label="Types" desc="All three keep the page controls on the right. The left side holds what people need next: a rows select, a count, or nothing but the context">
    <div class="tile-stack">
      {types.map((t) => (
        <div class="tile tile-static tile-wide">
          <span class="tile-top"><span class="label muted">Type={t} · {typeName[t]}</span></span>
          <span class="tile-body"><Fragment set:html={render({ type: t, size: 'Small', page: 1 })} /></span>
          <span class="label muted">{typeNotes[t]}</span>
        </div>
      ))}
    </div>
  </Section>

  <Section id="sizes" label="Sizes" desc="Match the table or list it controls: Large for full pages, Medium for most tables, Small inside cards and side panels">
    <div class="tile-stack">
      {sizes.map((z) => (
        <div class="tile tile-static tile-wide">
          <span class="tile-top"><span class="big">{metrics[z].h}</span><span class="label muted">{z} · {metrics[z].text}</span></span>
          <span class="tile-body"><Fragment set:html={render({ type: '03', size: z, page: 2 })} /></span>
        </div>
      ))}
    </div>
  </Section>

  <Section id="states" label="States" desc="Numbers and actions are flat until hovered. The current page gets a stroke/soft-200 outline, and actions at either end are disabled">
    <div class="grid3">
      {states.map(([k, s, name]) => (
        <div class="tile tile-static tile-v">
          <span class="tile-top"><span class="label muted">{name}</span></span>
          <span class="tile-body"><span class="surface"><Fragment set:html={part(k, s)} /></span></span>
        </div>
      ))}
    </div>
  </Section>

  <Section id="usage" label="Usage" title="When to use">
    <Usage
      use={['A table or list has more items than fit comfortably on one screen', 'People need to jump to a page or come back to the same place later', 'The total count helps people judge how much is left']}
      avoid={['People browse a feed with no end, load more as they scroll', 'The list is short enough to show in full', 'People move through steps of one task, use a Stepper']}
    />
  </Section>

  <Section id="guidance" label="Guidance" title="Do and don’t">
    <DoDont
      doText="Disable Previous on the first page and Next on the last, so the ends are clear"
      dontText="Don’t list every page number, keep the first, the last and the ones around the current page"
    >
      <Fragment slot="do"><span class="surface"><Fragment set:html={render({ type: '03', size: 'Small', page: 1, items: 50 })} /></span></Fragment>
      <Fragment slot="dont"><span class="surface"><span class="u-pg" data-size="small"><span class="u-pg-acts">{Array.from({ length: 9 }, (_, i) => <span class="u-pg-num" data-state={i === 0 ? 'select' : undefined}>{i + 1}</span>)}</span></span></span></Fragment>
    </DoDont>
  </Section>

  <Section id="specs" label="Specs" title="Tokens and specs">
    <SpecsTable label="Pagination tokens and specs" rows={specs} />
  </Section>

  <Section id="related" label="Related" title="Related components">
    <Related items={[
      ['Dropdown', 'Pick rows per page'],
      ['Tab Menu', 'Switch views of the data'],
      ['Breadcrumbs', 'Show where a page sits'],
      ['Button', 'Load more results'],
    ]} />
  </Section>
</DocPage>
